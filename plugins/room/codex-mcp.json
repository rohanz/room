{
  "mcpServers": {
    "room": {
      "command": "node",
      "args": [
        "./server/room-mcp.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "PWD",
        "ROOM_SERVER",
        "ROOM_TOKEN",
        "ROOM_WEB",
        "ROOM_URL",
        "ROOM_NAME",
        "ROOM_DIR",
        "ROOM_TAG",
        "ROOM_CREDENTIALS",
        "ROOM_STALE_DAYS",
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "XDG_CONFIG_HOME",
        "HOME"
      ],
      "startup_timeout_sec": 30
    }
  }
}
