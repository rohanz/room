{
  "mcpServers": {
    "room": {
      "command": "node",
      "args": [
        "./server/room-mcp.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "PWD",
        "ROOM_SERVER",
        "ROOM_TOKEN",
        "ROOM_WEB",
        "ROOM_URL",
        "ROOM_NAME",
        "ROOM_DIR",
        "ROOM_TAG",
        "ROOM_CREDENTIALS",
        "ROOM_STALE_DAYS",
        "XDG_CONFIG_HOME",
        "HOME",
        "ROOM_ROOM",
        "ROOM_LEAD",
        "ROOM_SHARE",
        "ROOM_KIND",
        "ROOM_MAX_WORKERS",
        "ROOM_LOG_FILE",
        "ROOM_OWNER",
        "ROOM_CLAUDE_CHANNEL",
        "ROOM_NAME_EPOCH",
        "ROOM_WORKER_THREADS",
        "ROOM_WORKER_MEM_GB",
        "ROOM_WORKER_HOST",
        "ROOM_WORKER_MODEL",
        "ROOM_WORKER_EFFORT",
        "ROOM_CODEX_WORKER_MODEL",
        "ROOM_CODEX_WORKER_EFFORT",
        "ROOM_CLAUDE_WORKER_MODEL",
        "ROOM_CLAUDE_WORKER_EFFORT",
        "ROOM_WORKER_ID",
        "ROOM_WORKER_RUN",
        "ROOM_LAUNCH_NONCE",
        "ROOM_REGISTRY",
        "ROOM_AUTO_FETCH",
        "ROOM_GIT_TIMEOUT_MS",
        "ROOM_IDLE_LEASE_MS",
        "ROOM_WORKER_MAX_BUDGET_USD",
        "ROOM_WORKER_NICE",
        "ROOM_PREVIEW_CACHE_GB",
        "ROOM_WAKE"
      ],
      "startup_timeout_sec": 30,
      "env": {
        "ROOM_HOST": "codex"
      }
    }
  }
}
