{
  "mcpServers": {
    "room": {
      "command": "node",
      "args": [
        "./server/room-mcp.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "PWD",
        "ROOM_SERVER",
        "ROOM_TOKEN",
        "ROOM_WEB",
        "ROOM_URL",
        "ROOM_NAME",
        "ROOM_DIR",
        "ROOM_TAG",
        "ROOM_CREDENTIALS",
        "ROOM_STALE_DAYS",
        "XDG_CONFIG_HOME",
        "HOME",
        "ROOM_ROOM",
        "ROOM_LEAD",
        "ROOM_SHARE",
        "ROOM_KIND",
        "ROOM_MAX_WORKERS",
        "ROOM_LOG_FILE",
        "ROOM_OWNER",
        "ROOM_CLAUDE_CHANNEL"
      ],
      "startup_timeout_sec": 30,
      "env": {
        "ROOM_HOST": "codex"
      }
    }
  }
}
