{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node ./hooks/session-start.mjs", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "apply_patch|Write|Edit", "hooks": [ { "type": "command", "command": "node ./hooks/before-edit.mjs", "timeout": 5 } ] }
    ]
  }
}
