# Room server both laptops connect to. The token is shared out-of-band with your teammates.
# Hosted: wss://<app>.fly.dev/?token=<token>     Local: ws://localhost:1234
ROOM_SERVER=wss://room-rohanz.fly.dev/?token=<ask-rohan>
# Optional: where `npm run web` is served, used for the browser URL room_join prints.
ROOM_WEB=http://localhost:5173
