# Room client (Codex plugin / room-mcp). Nothing is required for the hosted GitHub flow:
# the room server defaults to wss://room-rohanz.fly.dev; on first use the agent runs
# room_login (GitHub device login) and stores a session in ~/.config/room/credentials.json.
#ROOM_CREDENTIALS=                          # override the credentials file path
#ROOM_SERVER=ws://localhost:1234            # local server; add ?token=<shared> for ROOM_TOKEN servers
#ROOM_WEB=http://localhost:5173             # where the browser view is served (defaults to the server host)
#ROOM_GIT_TIMEOUT_MS=20000                  # daemon git command timeout
#ROOM_STALE_DAYS=7                          # evict uncommitted work of people absent this long
#ROOM_TAG=codex                             # second principal under your login: participant becomes <login>+codex
#ROOM_KIND=agent                            # agent (default) | bot | ci: how this session presents itself
#ROOM_SHARE=full                            # intent | declared | full (default): how much of the clone the room sees; declared is
                                            # recommended for teams (file text only under your room_scope paths). room_share changes it live.

# Room server (packages/server).
#PORT=1234
#HOST=0.0.0.0
#GITHUB_CLIENT_ID=                          # OAuth App client id (Device Flow enabled): users log in with room_login and the
                                            # server holds their GitHub token. Unset = clients forward their own gh token (local dev).
#ROOM_TOKEN=                                # shared token that admits any room (non-GitHub repos only; leave unset on a GitHub-only server)
#YPERSISTENCE=/data                         # LevelDB dir: rooms, view keys and the open-repo registry survive restarts
#ROOM_IDLE_DAYS=30                          # auto-close repos nobody connected to for this long (0 = never)
#ROOM_SHARE_MAX=full                        # intent | declared | full (default): ceiling on clients' ROOM_SHARE, advertised as shareMax in GET /auth/config
#ROOM_STATIC=./public                       # built browser view to serve at /
