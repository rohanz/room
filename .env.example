# Room client (Codex / Claude Code plugin, room-mcp). Nothing is required: without ROOM_SERVER a
# session is in a LOCAL room on this machine (no server, no login). Set ROOM_SERVER to work with
# teammates: "hosted" is wss://room-rohanz.fly.dev; on first use the agent runs room_login
# (GitHub device login) and stores a session in ~/.config/room/credentials.json.
#ROOM_SERVER=hosted                         # local (default) | hosted | ws(s)://host[:port][/?token=<shared>]; overrides the choice remembered per clone
#ROOM_WEB_DIST=                             # built browser view for the local relay to serve (default: the plugin's web/ or packages/web/dist)
#ROOM_CREDENTIALS=                          # override the credentials file path
#ROOM_ROOM=                                 # explicit room name (workers get the lead's room this way)
#ROOM_MAX_WORKERS=8                         # running workers per lead (room_spawn)
# Local rooms bind a port derived from the clone's git dir (40000-59999) and write .git/room-local.json (0600) with the key every websocket must carry.
#ROOM_WEB=http://localhost:5173             # where the browser view is served (defaults to the server host)
#ROOM_GIT_TIMEOUT_MS=20000                  # daemon git command timeout
#ROOM_STALE_DAYS=7                          # evict uncommitted work of people absent this long
#ROOM_TAG=codex                             # second principal under your login: participant becomes <login>+codex
#ROOM_KIND=agent                            # agent (default) | bot | ci: how this session presents itself
#ROOM_SHARE=full                            # intent | declared | full (default): how much of the clone the room sees; declared is
                                            # recommended for teams (file text only under your room_scope paths). room_share changes it live.

# Room server (packages/server).
#PORT=1234
#HOST=0.0.0.0
#GITHUB_CLIENT_ID=                          # OAuth App client id (Device Flow enabled): users log in with room_login and the
                                            # server holds their GitHub token. The ONLY way into github.com/... rooms; forwarded gh
                                            # tokens are refused. Unset = no GitHub rooms. `fake` = test issuer (tests, scripts/demo.sh;
                                            # refused with NODE_ENV=production): /auth/poll confirms with the body's fakeLogin.
#ROOM_TOKEN=                                # shared token admitting non-GitHub rooms only (local/..., git/...); never a github.com room
#YPERSISTENCE=/data                         # LevelDB dir: rooms, view keys and the open-repo registry survive restarts
#ROOM_IDLE_DAYS=30                          # auto-close repos nobody connected to for this long (0 = never)
#ROOM_DOC_MAX_MB=64                         # refuse writes into a room document larger than this
#ROOM_MAX_MESSAGE_MB=16                     # drop websocket messages larger than this (a bloated client copy)
#ROOM_SHARE_MAX=full                        # intent | declared | full (default): ceiling on clients' ROOM_SHARE, advertised as shareMax in GET /auth/config
#ROOM_STATIC=./public                       # built browser view to serve at /
