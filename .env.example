# Room client (Codex plugin / room-mcp). Nothing is required for the hosted GitHub flow:
# the room server defaults to wss://room-rohanz.fly.dev and access is proven with your
# `gh` login (or GH_TOKEN / GITHUB_TOKEN).
#ROOM_SERVER=ws://localhost:1234            # local server; add ?token=<shared> for ROOM_TOKEN servers
#ROOM_WEB=http://localhost:5173             # where the browser view is served (defaults to the server host)
#ROOM_GIT_TIMEOUT_MS=20000                  # daemon git command timeout

# Room server (packages/server).
#PORT=1234
#HOST=0.0.0.0
#ROOM_TOKEN=                                # shared token that admits any room (non-GitHub repos, or override)
#YPERSISTENCE=/data                         # LevelDB dir: rooms, view keys and the open-repo registry survive restarts
#ROOM_STATIC=./public                       # built browser view to serve at /
