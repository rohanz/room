# Copy to .env next to docker-compose.yml. Every variable is optional; see deploy/self-hosting.md.

# Server image tag. The image version matches the plugin version: use the one your team has installed.
# latest follows the newest release; pin with a version, for example:
#ROOM_IMAGE_TAG=0.17.56

# External https URL of this server (required for OIDC; used to build the redirect URI).
PUBLIC_URL=https://room.example.com

# Behind a TLS reverse proxy (the normal setup): count real client addresses for the per-address limits.
ROOM_TRUST_PROXY=true

# --- Login: GitHub OAuth App (device flow) ---
GITHUB_CLIENT_ID=

# --- Login: OIDC (Okta, Google, Keycloak, Entra ID, ...) ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAINS=example.com

# Operator identities: GitHub logins or full OIDC identities (comma list).
ROOM_ADMINS=

# Optional: only ROOM_ADMINS can open/close repos; collaborators can still join.
#ROOM_MANAGED_REPOS=true

# Shared token: admits non-GitHub rooms only; never grants repository management.
ROOM_TOKEN=

# Ceiling on what clients may share: intent | declared | full
ROOM_SHARE_MAX=full
# Close repos nobody has connected to for this many days (0 disables).
ROOM_IDLE_DAYS=30
