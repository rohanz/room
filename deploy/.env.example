# Copy to deploy/.env. Every variable is optional; see deploy/self-hosting.md for the full table.

# External https URL of this server (required for OIDC; used to build the redirect URI).
PUBLIC_URL=https://room.example.com

# --- Login: GitHub OAuth App (device flow) ---
GITHUB_CLIENT_ID=

# --- Login: OIDC (Okta, Google, Keycloak, Entra ID, ...) ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAINS=example.com

# Logins allowed to read GET /audit (comma list).
ROOM_ADMINS=

# Shared token: anyone with it is admitted to every room (fallback when no login is configured).
ROOM_TOKEN=

# Postgres for the repo registry, sessions and audit log (docs stay in LevelDB on the volume).
# With the compose "postgres" profile: postgres://room:room@postgres:5432/room
DATABASE_URL=

# Ceiling on what clients may share: intent | declared | full
ROOM_SHARE_MAX=full
# Close repos nobody has connected to for this many days (0 disables).
ROOM_IDLE_DAYS=30
