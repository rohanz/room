{
  "tools": [
    {
      "name": "room_login",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "description": "Use to sign in or out. Show the login code/URL, then call again to wait.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "login",
              "logout"
            ]
          },
          "provider": {
            "type": "string",
            "enum": [
              "github",
              "oidc"
            ]
          },
          "wait": {
            "type": "integer",
            "description": "wait seconds, default 90, max 600"
          },
          "server": {
            "type": "string",
            "description": "server URL"
          },
          "credentials": {
            "type": "string",
            "description": "credentials file"
          }
        }
      }
    },
    {
      "name": "room_create",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "description": "Use when asked to open this repo as a team room; confirm=true authorizes it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "confirm": {
            "type": "boolean"
          },
          "where": {
            "type": "string",
            "description": "team | server URL"
          },
          "room": {
            "type": "string",
            "description": "room name override"
          },
          "name": {
            "type": "string",
            "description": "name override"
          },
          "server": {
            "type": "string",
            "description": "alias of where"
          },
          "dir": {
            "type": "string",
            "description": "clone; default cwd"
          },
          "share": {
            "type": "string",
            "enum": [
              "intent",
              "declared",
              "full"
            ],
            "description": "intent: plans only; declared: scoped files; full: all changed files"
          }
        }
      }
    },
    {
      "name": "room_join",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "description": "Use for \"join the room\", \"work locally\", or moving rooms. Remembers this clone\u2019s choice.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "where": {
            "type": "string",
            "description": "local | team | server URL"
          },
          "room": {
            "type": "string",
            "description": "room name override"
          },
          "name": {
            "type": "string",
            "description": "name override"
          },
          "server": {
            "type": "string",
            "description": "alias of where"
          },
          "dir": {
            "type": "string",
            "description": "clone; default cwd"
          },
          "share": {
            "type": "string",
            "enum": [
              "intent",
              "declared",
              "full"
            ],
            "description": "intent: plans only; declared: scoped files; full: all changed files"
          },
          "takeover": {
            "type": "boolean",
            "description": "take a local name only when its process identity is unknown"
          }
        }
      }
    },
    {
      "name": "room_leave",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "description": "Use for \"stop sharing\" or \"leave the room\". Releases claims; force dismisses workers; forget clears saved choice. To \"work locally\", use room_join.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "forget": {
            "type": "boolean"
          },
          "force": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "room_close",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "description": "Use only when asked to close the room for everyone; exports history, then deletes it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "confirm": {
            "type": "boolean"
          }
        },
        "required": [
          "confirm"
        ]
      }
    },
    {
      "name": "room_export",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "description": "Use to export room history or a legacy archive as Markdown.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "room": {
            "type": "string",
            "description": "legacy branch room"
          },
          "path": {
            "type": "string",
            "description": "output Markdown path"
          }
        }
      }
    },
    {
      "name": "room_scope",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "description": "Use when starting work with others: declare task and edit paths once.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "area": {
            "type": "string",
            "description": "one word, lowercase"
          },
          "summary": {
            "type": "string",
            "description": "one line"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "non-empty edit files or directories"
          }
        },
        "required": [
          "area",
          "summary",
          "paths"
        ]
      }
    },
    {
      "name": "room_state",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "description": "Use for \"who\u2019s here?\", file ownership, or \"is Room set up right?\" check=true checks my setup (room doctor); link gets the browser URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "all": {
            "type": "boolean"
          },
          "path": {
            "type": "string",
            "description": "file ownership"
          },
          "from": {
            "type": "integer",
            "description": "first line"
          },
          "to": {
            "type": "integer",
            "description": "last line"
          },
          "link": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "room_read",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "description": "Use to read a teammate\u2019s live file or diff; omit path for all diffs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "repo-relative path"
          },
          "person": {
            "type": "string",
            "description": "default you"
          },
          "diff": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "room_claim",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "description": "Use before editing a file near another participant. Claim a symbol, line range, or directory; declare public API plans.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "repo-relative path; directory ends /"
          },
          "symbol": {
            "type": "string",
            "description": "definition name, or from/to"
          },
          "from": {
            "type": "integer",
            "description": "first line"
          },
          "to": {
            "type": "integer",
            "description": "last line"
          },
          "intent": {
            "type": "string",
            "description": "intent"
          },
          "plans": {
            "type": "array",
            "description": "Public API changes planned before editing.",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "rename",
                    "signature",
                    "delete",
                    "add"
                  ]
                },
                "symbol": {
                  "type": "string",
                  "description": "current symbol"
                },
                "detail": {
                  "type": "string",
                  "description": "new name/signature or reason"
                }
              },
              "required": [
                "kind",
                "symbol"
              ]
            }
          }
        },
        "required": [
          "path",
          "intent"
        ]
      }
    },
    {
      "name": "room_release",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "description": "Use to release a claim early. room_done releases remaining claims; list completed symbols in done.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "claimId": {
            "type": "string",
            "description": "claim id"
          },
          "summary": {
            "type": "string",
            "description": "what changed, one line"
          },
          "done": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "completed symbols"
          }
        },
        "required": [
          "claimId"
        ]
      }
    },
    {
      "name": "room_send",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "description": "Use to \"tell X\", \"ask the worker a follow-up\", or \"interrupt the worker\" (priority=interrupt); message a finished worker to resume it in its worktree.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "changed",
              "question",
              "answer",
              "note"
            ]
          },
          "to": {
            "type": "string",
            "description": "recipient; omit to broadcast"
          },
          "text": {
            "type": "string",
            "description": "message text / change summary; or use message"
          },
          "message": {
            "type": "string",
            "description": "alias for text"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "paths touched (changed)"
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "changed symbols"
          },
          "inReplyTo": {
            "type": "string",
            "description": "question id (answer) or addressed note id (note reply)"
          },
          "priority": {
            "type": "string",
            "enum": [
              "fyi",
              "notify",
              "interrupt"
            ],
            "description": "urgency override"
          }
        },
        "required": [
          "type"
        ]
      }
    },
    {
      "name": "room_wait",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "description": "Use when waiting for an answer, claim release, worker completion, or interrupt. On timeout, wait again if still blocked.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "claimId": {
            "type": "string",
            "description": "claim id"
          },
          "questionId": {
            "type": "string",
            "description": "question id"
          },
          "timeoutMs": {
            "type": "integer",
            "description": "default 30000, max 100000"
          }
        }
      }
    },
    {
      "name": "room_done",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "description": "Use when finished: report one-line progress and tests, release claims, then exit if you are a worker.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "description": "one line: what landed and the test result"
          },
          "pr_note": {
            "type": "boolean",
            "description": "post ledger on current branch PR"
          }
        },
        "required": [
          "summary"
        ]
      }
    },
    {
      "name": "room_pr_note",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "description": "Use when asked to post Room activity on a GitHub PR. Updates the room ledger on this branch\u2019s PR by default.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "description": "PR number"
          }
        }
      }
    },
    {
      "name": "room_impact",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "description": "Use before changing a public function or file: find who depends on it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "description": "function/class/variable name"
          },
          "path": {
            "type": "string",
            "description": "repo-relative path"
          }
        }
      }
    },
    {
      "name": "room_preview_merge",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "description": "Use for \"will our changes work together?\" or \"check for conflicts before I finish\"; optionally run tests.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "people": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "participants in merge order; default all"
          },
          "person": {
            "type": "string",
            "description": "one participant"
          },
          "includeOffline": {
            "type": "boolean",
            "description": "include offline overlays"
          },
          "run": {
            "type": "string",
            "description": "test command"
          },
          "resolve": {
            "type": "boolean",
            "description": "resolve superset conflicts"
          }
        }
      }
    },
    {
      "name": "room_share",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "description": "Use to check or change what others see: \"share plans only\", \"only my declared files\", or \"share all changed files\".",
      "inputSchema": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "intent",
              "declared",
              "full"
            ],
            "description": "intent: plans only; declared: scoped files; full: all changed files"
          }
        }
      }
    },
    {
      "name": "room_spawn",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "description": "Use for another agent (claude/codex), agents in parallel, work in the background, or codex/claude to do part of it; message a finished worker to resume it in its worktree.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string",
            "description": "worker tag"
          },
          "task": {
            "type": "string",
            "description": "task"
          },
          "host": {
            "type": "string",
            "enum": [
              "claude",
              "codex"
            ],
            "description": "default: caller host"
          },
          "model": {
            "type": "string",
            "description": "host model override"
          },
          "effort": {
            "type": "string",
            "enum": [
              "minimal",
              "low",
              "medium",
              "high"
            ],
            "description": "reasoning effort"
          },
          "link": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "input paths; default .roomlinks; [] disables"
          },
          "carry": {
            "type": "boolean",
            "description": "false: start from HEAD"
          },
          "threads": {
            "type": "integer",
            "minimum": 1,
            "description": "worker thread budget"
          },
          "share": {
            "type": "string",
            "enum": [
              "intent",
              "declared",
              "full"
            ],
            "description": "intent: plans only; declared: scoped files; full: all changed files"
          },
          "allowOutside": {
            "type": "boolean",
            "description": "allow a team worker outside this repo"
          },
          "dir": {
            "type": "string",
            "description": "existing directory; no new worktree"
          },
          "where": {
            "type": "string",
            "enum": [
              "here",
              "local"
            ],
            "description": "here (default) or local workers room"
          }
        },
        "required": [
          "tag",
          "task"
        ]
      }
    },
    {
      "name": "room_collect",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "description": "Use to \"bring in their work\" or \"take the worker's changes\" as unstaged edits; discard to \"throw away the worker\". Skips live workers; tag a stopped worker for partial edits. Conflicts write nothing.",
      "inputSchema": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "tag": {
            "type": "string",
            "description": "worker tag"
          },
          "mode": {
            "type": "string",
            "enum": [
              "apply",
              "copy"
            ]
          },
          "discard": {
            "type": "boolean"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "copy mode: repo-relative files or directories"
          },
          "force": {
            "type": "boolean",
            "description": "overwrite modified copy destinations; discard ignored artifacts too"
          }
        }
      }
    }
  ]
}